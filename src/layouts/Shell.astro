---
import { ClientRouter } from "astro:transitions";
import Stage from "../components/stage/Stage.astro";
import Player from "../components/player/Player";
import Icon from "../components/Icon.astro";
import { visiblePosts, realPosts, isPreview } from "../lib/content";
import { mixes } from "../lib/catalogue";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import "../styles/phase2.css";
import "../styles/motion.css";
const { title = "Brian Dillon", section = "home" } = Astro.props;
const posts = await visiblePosts(),
  published = await realPosts();
const nav = [
  { name: "Music", href: "/music" },
  { name: "Mixes", href: "/mixes" },
  { name: "Work", href: "/work" },
  ...(posts.length ? [{ name: "Writing", href: "/writing" }] : []),
  { name: "About", href: "/about" },
];
const pageMedia = mixes
  .filter((m) => m.src)
  .map((m) => ({
    id: m.id,
    kind: m.kind,
    title: m.title,
    artist: m.artist,
    src: m.src,
    duration: m.duration,
    artwork: m.artwork,
    href: m.href,
    peaksUrl: m.peaks,
    scoreUrl: m.scoreUrl,
    boundariesSec: [],
    bpm: null,
    beatStartAtSec: null,
  }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#0b0c0e" />
    <meta
      name="description"
      content="Brian Dillon. Music as Brian Diolún. Mixes as Roam. Software at rdelune."
    />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter fallback="swap" />
  </head>
  <body data-section={section} data-preview={isPreview ? "true" : undefined}>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <Stage />
    <header class="topbar">
      <a href="/" class="identity" aria-label="Brian Dillon home">
        <span class="identity-mark">
          b<span>∕</span>d
        </span>
        <span>Brian Dillon</span>
      </a>
      <div class="topbar-right">
        <a
          href="https://rdelune.dev"
          class="external-link"
          target="_blank"
          rel="noreferrer"
        >
          rdelune <Icon name="external" size={14} />
        </a>
        <button
          class="menu-trigger"
          aria-haspopup="dialog"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          Menu <span>＋</span>
        </button>
      </div>
    </header>
    <nav class="rail" aria-label="Primary" transition:persist="rail">
      <span class="rail-label micro">INDEX</span>
      <span class="rail-active" aria-hidden="true"></span>
      {nav.map((item, i) => (
        <a
          href={item.href}
          data-astro-prefetch
          aria-current={
            section === item.name.toLowerCase() ? "page" : undefined
          }
        >
          <span class="nav-index">{String(i + 1).padStart(2, "0")}</span>
          <span>{item.name}</span>
        </a>
      ))}
    </nav>
    <dialog id="mobile-menu" aria-label="Site navigation">
      <div class="dialog-top">
        <span class="micro">INDEX</span>
        <button class="menu-close" aria-label="Close menu">
          Close ×
        </button>
      </div>
      <nav aria-label="Mobile primary">
        {nav.map((item, i) => (
          <a
            href={item.href}
            aria-current={
              section === item.name.toLowerCase() ? "page" : undefined
            }
          >
            <span class="micro">{String(i + 1).padStart(2, "0")}</span>
            {item.name}
          </a>
        ))}
      </nav>
      <button class="motion-toggle text-control" aria-pressed="false">
        Pause animation
      </button>
    </dialog>
    <main id="main" tabindex="-1" transition:name="content">
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/" class="footer-signature">
        Brian Dillon <span>© {new Date().getFullYear()}</span>
      </a>
      <div class="footer-links">
        <a
          href="https://www.mixcloud.com/brian-diolun/"
          target="_blank"
          rel="noreferrer"
        >
          Mixcloud ↗
        </a>
        <a
          href="https://soundcloud.com/brian-d"
          target="_blank"
          rel="noreferrer"
        >
          SoundCloud ↗
        </a>
        <a href="https://rdelune.dev" target="_blank" rel="noreferrer">
          rdelune ↗
        </a>
        {published.length > 0 && <a href="/rss.xml">RSS</a>}
        <button class="motion-toggle text-control" aria-pressed="false">
          <span class="motion-dot"></span>
          <span class="motion-label">Pause animation</span>
        </button>
        {import.meta.env.DEV && (
          <button class="framing-toggle text-control" aria-pressed="false">
            Framing: fixed
          </button>
        )}
      </div>
    </footer>
    <script
      id="media-catalogue"
      type="application/json"
      set:html={JSON.stringify(pageMedia).replaceAll("<", "\\u003c")}
    />
    <Player client:load transition:persist="player" transition:name="player" />
    <script>
      import { bindPlayback } from "../lib/player";
      import { bindAppNavigation } from "../lib/navigation";
      bindPlayback();
      bindAppNavigation();
    </script>
  </body>
</html>
