---
import { ClientRouter } from "astro:transitions";
import Stage from "../components/stage/Stage.astro";
import Player from "../components/player/Player";
import Icon from "../components/Icon.astro";
import { visiblePosts, realPosts, isPreview } from "../lib/content";
import { mixes } from "../lib/catalogue";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import "../styles/phase2.css";
import "../styles/motion.css";
interface Props {
  title?: string;
  section?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  article?: { datePublished: string; headline: string };
}
const descriptions: Record<string, string> = {
  home: "Music by Brían Diolún, DJ mixes as Roam, and software work at rdelune. Listen to releases and mixes, explore projects, and read recent writing.",
  music: "Listen to original releases by Brían Diolún. Explore albums, artwork, and individual tracks.",
  mixes: "DJ mixes by Roam: explore the archive, browse tracklists, and listen with timestamped chapters.",
  work: "Software work and experience from Brían Diolún, with consultancy through rdelune.",
  writing: "Writing by Brían Diolún on music, software, and current projects.",
  about: "About Brían Diolún: musician, DJ as Roam, and software consultant at rdelune.",
};
const { title = "Brían Diolún — Music, mixes & software", section = "home", description = descriptions[section] || descriptions.home, image = "/social/default.png", noindex = false, article } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site);
const socialImage = new URL(image, Astro.site);
const preventIndexing = isPreview || noindex;
const person = {
  "@type": "Person", "@id": new URL("/about#person", Astro.site).href,
  name: "Brían Diolún", alternateName: "Roam", url: new URL("/about", Astro.site).href,
  sameAs: ["https://www.mixcloud.com/brian-diolun/", "https://soundcloud.com/brian-d", "https://rdelune.dev"],
};
const structuredData = article ? {
  "@context": "https://schema.org", "@type": "BlogPosting", ...article,
  author: person, mainEntityOfPage: canonical.href, image: socialImage.href,
} : section === "about" ? {
  "@context": "https://schema.org", "@type": "ProfilePage", url: canonical.href, mainEntity: person,
} : section === "home" ? {
  "@context": "https://schema.org", "@type": "WebSite", name: "Brían Diolún", url: canonical.href,
} : null;
const posts = await visiblePosts(),
  published = await realPosts();
const nav = [
  { name: "Music", href: "/music" },
  { name: "Mixes", href: "/mixes" },
  { name: "Work", href: "/work" },
  ...(posts.length ? [{ name: "Writing", href: "/writing" }] : []),
  { name: "About", href: "/about" },
];
const pageMedia = mixes
  .filter((m) => m.src)
  .map((m) => ({
    id: m.id,
    kind: m.kind,
    title: m.title,
    artist: m.artist,
    src: m.src,
    duration: m.duration,
    artwork: m.artwork,
    href: m.href,
    peaksUrl: m.peaks,
    scoreUrl: m.scoreUrl,
    tracklist: m.tracklist,
    boundariesSec: m.tracklist.map((chapter) => chapter.at),
    bpm: null,
    beatStartAtSec: null,
  }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="description" content={description} />
    {preventIndexing && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical.href} />}
    <meta property="og:site_name" content="Brían Diolún" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:alt" content={image === "/social/default.png" ? "Brían Diolún — Music, mixes and software" : title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    {article && <meta property="article:published_time" content={article.datePublished} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />}
    {published.length > 0 && <link rel="alternate" type="application/rss+xml" title="Brían Diolún — Writing" href="/rss.xml" />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter fallback="swap" />
  </head>
  <body data-section={section} data-preview={isPreview ? "true" : undefined}>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <Stage />
    <header class="topbar">
      <a href="/" class="identity" aria-label="Brían Diolún home">
        <span class="identity-mark">
          b<span>∕</span>d
        </span>
        <span>Brían Diolún</span>
      </a>
      <div class="topbar-right">
        <a
          href="https://rdelune.dev"
          class="external-link"
          target="_blank"
          rel="noreferrer"
        >
          rdelune <Icon name="external" size={14} />
        </a>
        <button
          class="menu-trigger"
          aria-haspopup="dialog"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          Menu <span>＋</span>
        </button>
      </div>
    </header>
    <nav
      data-stage-exclude
      class="rail"
      aria-label="Primary"
      transition:persist="rail"
    >
      <span class="rail-label micro">INDEX</span>
      <span class="rail-active" aria-hidden="true"></span>
      {nav.map((item, i) => (
        <a
          href={item.href}
          data-astro-prefetch
          aria-current={
            section === item.name.toLowerCase() ? "page" : undefined
          }
        >
          <span class="nav-index">{String(i + 1).padStart(2, "0")}</span>
          <span>{item.name}</span>
        </a>
      ))}
    </nav>
    <dialog id="mobile-menu" aria-label="Site navigation">
      <div class="dialog-top">
        <span class="micro">INDEX</span>
        <button class="menu-close" aria-label="Close menu">
          Close ×
        </button>
      </div>
      <nav aria-label="Mobile primary">
        {nav.map((item, i) => (
          <a
            href={item.href}
            aria-current={
              section === item.name.toLowerCase() ? "page" : undefined
            }
          >
            <span class="micro">{String(i + 1).padStart(2, "0")}</span>
            {item.name}
          </a>
        ))}
      </nav>
      <button class="motion-toggle text-control" aria-pressed="false">
        Pause animation
      </button>
    </dialog>
    <main id="main" tabindex="-1" transition:name="content">
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/" class="footer-signature">
        Brían Diolún <span>© {new Date().getFullYear()}</span>
      </a>
      <div class="footer-links">
        <a
          href="https://www.mixcloud.com/brian-diolun/"
          target="_blank"
          rel="noreferrer"
        >
          Mixcloud ↗
        </a>
        <a
          href="https://soundcloud.com/brian-d"
          target="_blank"
          rel="noreferrer"
        >
          SoundCloud ↗
        </a>
        <a href="https://rdelune.dev" target="_blank" rel="noreferrer">
          rdelune ↗
        </a>
        {published.length > 0 && <a href="/rss.xml">RSS</a>}
        <button class="motion-toggle text-control" aria-pressed="false">
          <span class="motion-dot"></span>
          <span class="motion-label">Pause animation</span>
        </button>
        {import.meta.env.DEV && (
          <button class="framing-toggle text-control" aria-pressed="false">
            Framing: fixed
          </button>
        )}
      </div>
    </footer>
    <script
      id="media-catalogue"
      type="application/json"
      set:html={JSON.stringify(pageMedia).replaceAll("<", "\\u003c")}
    />
    <Player client:load transition:persist="player" transition:name="player" />
    <script>
      import { bindPlayback } from "../lib/player";
      import { bindAppNavigation } from "../lib/navigation";
      bindPlayback();
      bindAppNavigation();
    </script>
  </body>
</html>
