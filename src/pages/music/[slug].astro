---
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import { releases, time } from '../../lib/catalogue';
export const getStaticPaths = () => releases.map(release => ({ params: { slug: release.slug }, props: { release } }));
const { release } = Astro.props;
---
<Shell title={`${release.title} — Brian Dillon`} section="music"><div class="page-column inner-page"><a href="/music" class="back-link micro">← ALL RELEASES</a><div class="release-detail"><img src={release.artwork} width="600" height="600" alt={`${release.title} artwork`} transition:name={`cover-${release.slug}`}/><div><p class="micro section-index">{release.artist} / {release.year}</p><h1 class="detail-title">{release.title}</h1><p class="muted">{release.tracks.length} tracks</p><button class="primary-action" data-track-id={release.tracks[0].id}><Icon name="play"/>Play release</button></div></div><div class="track-list">{release.tracks.map((track,i) => <button class="track-row" data-track-id={track.id}><span class="micro">{String(i+1).padStart(2,'0')}</span><span>{track.title}</span><span class="micro">{time(track.duration)}</span><Icon name="play" size={16}/></button>)}</div></div></Shell>
