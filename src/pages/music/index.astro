---
import Shell from "../../layouts/Shell.astro";
import ReleaseCard from "../../components/ReleaseCard.astro";
import { releases } from "../../lib/catalogue";
---

<Shell title="Music — Brían Diolún" section="music">
  <div class="page-column inner-page">
    <header class="page-header">
      <h1 data-stage-exclude class="page-title">Music</h1>
      <p data-stage-exclude class="micro route-body">{releases.length} RELEASES</p>
    </header>
    <div data-stage-exclude class="release-grid">
      {releases.map((release) => (
        <ReleaseCard release={release} />
      ))}
    </div>
  </div>
</Shell>
