---
import Shell from "../../layouts/Shell.astro";
import MixScrubber from "../../components/player/MixScrubber";
import { mixes, time } from "../../lib/catalogue";
export const getStaticPaths = () =>
  mixes.map((mix) => ({ params: { slug: mix.slug }, props: { mix } }));
const { mix } = Astro.props;
---

<Shell title={`${mix.title} — Brian Dillon`} section="mixes">
  <div class="page-column inner-page mix-detail">
    <a href="/mixes" class="back-link micro">
      ← MIXES
    </a>
    <header class="page-header">
      <h1 data-stage-exclude class="page-title">{mix.title}</h1>
      <p data-stage-exclude class="micro route-body">
        {mix.year || "TODO(copy)"} · {time(mix.duration)} · {mix.series || "—"}
      </p>
      {mix.filename && (
        <p data-stage-exclude class="source-filename micro route-body">{mix.filename}</p>
      )}
    </header>
    <MixScrubber
      client:load
      id={mix.id}
      src={mix.src}
      duration={mix.duration}
      peaks={mix.peaks}
    />
    {!mix.src && (
      <a href="https://www.mixcloud.com/brian-diolun/" class="quiet-link">
        Mixcloud ↗
      </a>
    )}
  </div>
</Shell>
