---
import Shell from "../../layouts/Shell.astro";
import MixRow from "../../components/MixRow.astro";
import { mixes, visibleYearRange } from "../../lib/catalogue";
---

<Shell title="Mixes — Brían Diolún" section="mixes">
  <div class="page-column inner-page">
    <header class="page-header">
      <h1 data-stage-exclude class="page-title">Mixes</h1>
      <p data-stage-exclude class="micro route-body">
        {mixes.length} MIXES
        {visibleYearRange(mixes) && ` · ${visibleYearRange(mixes)}`}
      </p>
    </header>
    <div data-stage-exclude class="mix-list">
      {mixes.map((mix, index) => (
        <MixRow mix={mix} index={index} />
      ))}
    </div>
  </div>
</Shell>
