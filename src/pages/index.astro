---
import Shell from "../layouts/Shell.astro";
import { releases, mixes, time } from "../lib/catalogue";
import { visiblePosts } from "../lib/content";
const featured = releases[0],
  latestRelease = [...releases].sort(
    (a, b) => Number(b.year) - Number(a.year),
  )[0];
const latestMix = mixes.find((m) => m.src),
  post = (await visiblePosts())[0];
---

<Shell>
  <section class="page-column home-screen">
    <div class="home-content">
      <h1 data-stage-exclude class="page-title">Brian Dillon</h1>
      <p data-stage-exclude class="fact-line route-body">
        Music as Brian Diolún. Mixes as Roam.
        <br />
        Software at <a href="https://rdelune.dev">rdelune ↗</a>
      </p>
      <div data-stage-exclude class="featured-listen route-body">
        <button class="primary-action" data-track-id={featured.tracks[0].id}>
          <span data-play-glyph>▶</span>
          {featured.title}
        </button>
        <span class="micro">
          {featured.year} ·{" "}
          {time(featured.tracks.reduce((n, t) => n + t.duration, 0))} ·{" "}
          {featured.artist}
        </span>
      </div>
      <div data-stage-exclude class="latest-block">
        <h2 class="micro">LATEST</h2>
        <div class="latest-row" data-row>
          <span class="micro">RELEASE</span>
          <a href={`/music/${latestRelease.slug}`}>{latestRelease.title}</a>
          <button
            data-track-id={latestRelease.tracks[0].id}
            aria-label={`Play ${latestRelease.title}`}
          >
            <span data-play-glyph>▶</span>
          </button>
          <a
            href={`/music/${latestRelease.slug}`}
            aria-label={`Open ${latestRelease.title}`}
          >
            →
          </a>
        </div>
        {latestMix && (
          <div class="latest-row" data-row>
            <span class="micro">MIX</span>
            <a href={latestMix.href}>{latestMix.title}</a>
            <button data-track-id={latestMix.id} aria-label="Play latest mix">
              <span data-play-glyph>▶</span>
            </button>
            <a href={latestMix.href} aria-label="Open latest mix">
              →
            </a>
          </div>
        )}
        {post && (
          <div class="latest-row" data-row>
            <span class="micro">
              {post.data.sample ? "SAMPLE POST" : "POST"}
            </span>
            <a href={`/writing/${post.data.slug}`}>{post.data.title}</a>
            <span></span>
            <a
              href={`/writing/${post.data.slug}`}
              aria-label={`Open ${post.data.title}`}
            >
              →
            </a>
          </div>
        )}
      </div>
    </div>
  </section>
</Shell>
