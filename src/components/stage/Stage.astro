---
// First paint shows the poster for this route's pose group, rendered from
// the real scene (scripts/render-posters.mjs), so the swap is invisible.
import { routePose } from "../../lib/stage-bridge";
import { routeGroup } from "./coupling.ts";
const group = routeGroup(routePose(Astro.url.pathname));
---
<div id="stage" class="stage" aria-hidden="true" transition:persist="stage" transition:name="stage">
  <picture class="stage-poster"><source media="(max-width:767px)" srcset={`/poster/${group}-mobile.avif`}/><img src={`/poster/${group}.avif`} alt="" width="1600" height="1000" fetchpriority="high"/></picture>
  <canvas id="horizon-canvas"></canvas>
  <div class="stage-shade"></div>
</div>
<script>
  import { launchStage } from './loader';
  launchStage();
</script>

<style>
  /* The scene and its posters already carry the shared film grain. */
  :global(body:has(#stage)::after) { display: none; }
</style>
