---
import { time } from "../lib/format";
import type { mixes } from "../lib/catalogue";
const { mix, index } = Astro.props as {
  mix: (typeof mixes)[number];
  index: number;
};
---

<article data-preload-artwork={mix.artwork} class="mix-row" data-row>
  <span class="micro mix-number">{String(index + 1).padStart(2, "0")}</span>
  <img
    class="mix-cover"
    src={mix.coverSmall}
    srcset={
      mix.cover === mix.coverSmall
        ? undefined
        : `${mix.coverSmall} 300w, ${mix.cover} 600w`
    }
    sizes="48px"
    width="48"
    height="48"
    alt=""
    loading="lazy"
    decoding="async"
  />
  <a href={mix.href} class="mix-title" data-astro-prefetch>
    {mix.title}
    {mix.filename && <span class="source-filename micro">{mix.filename}</span>}
    {mix.tracklist.length > 0 && (
      <span class="micro mix-track-count">{mix.tracklist.length} TRACKS</span>
    )}
  </a>
  <span class="mix-series micro">{mix.series || "—"}</span>
  <span class="micro mix-year">
    {mix.year ? `${mix.dateApprox ? "c. " : ""}${mix.year}` : "TODO(copy)"}
  </span>
  <span class="micro mix-duration">{time(mix.duration)}</span>
  <button
    class="row-play"
    data-track-id={mix.id}
    disabled={!mix.src}
    aria-label={
      mix.src
        ? `Play ${mix.filename || mix.title}`
        : `Audio unavailable for ${mix.title}`
    }
  >
    <span data-play-glyph>▶</span>
  </button>
  <a
    class="row-link"
    data-astro-prefetch
    href={mix.href}
    aria-label={`Open ${mix.filename || mix.title}`}
  >
    →
  </a>
</article>
