---
interface Props { name?: string; size?: number }
const { name = 'arrow', size = 18 } = Astro.props;
const paths: Record<string, string> = { arrow: 'M5 12h14M13 6l6 6-6 6', external: 'M7 17 17 7M7 7h10v10', play: 'm9 5 11 7-11 7V5Z', pause: 'M8 5v14M16 5v14', plus: 'M12 5v14M5 12h14', sound: 'M4 10v4h4l5 4V6l-5 4H4ZM17 8a7 7 0 0 1 0 8', moon: 'M20 14A8 8 0 0 1 10 4a8 8 0 1 0 10 10Z' };
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name] || paths.arrow}/></svg>
