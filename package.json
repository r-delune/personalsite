{
  "name": "brian-personal-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1 --port 4357",
    "check": "node scripts/astro.mjs check",
    "build": "node scripts/prepare-fixture.mjs && node scripts/astro.mjs build && node scripts/check-content.mjs",
    "build:preview": "node scripts/prepare-fixture.mjs && node scripts/astro.mjs build --mode preview",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1 --port 4358",
    "posters": "node scripts/generate-posters.mjs",
    "predev": "node scripts/prepare-fixture.mjs",
    "precheck": "node scripts/prepare-fixture.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.2",
    "@astrojs/preact": "6.1.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@nanostores/preact": "1.1.1",
    "astro": "7.4.4",
    "nanostores": "1.5.5",
    "preact": "11.1.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
