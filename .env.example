# Production origin for canonical URLs, sitemap, social previews and RSS.
PUBLIC_SITE_URL=https://me.rdelune.dev

# Base URL containing ROAM_MIX_2026.mp3. No trailing slash required.
# For dev delivery from a local master (no audio copied into the repo):
PUBLIC_MIX_MEDIA_BASE=/__local-media
LOCAL_MIX_FILE=/absolute/path/to/ROAM_MIX_2026.mp3
# For R2, set PUBLIC_MIX_MEDIA_BASE=https://your-media-host/mixes instead.

# Production PWA is on by default. Ordinary previews remain worker-free.
# Use PUBLIC_PWA_ENABLED=1 with pnpm build:preview for PWA staging tests.
# PUBLIC_PWA_ENABLED=0 disables registration and worker generation in production.
